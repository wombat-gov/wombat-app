{
  "name": "wombat-dashboard-app",
  "productName": "WOMBATpass Dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "macOS desktop shell for the WOMBATpass dashboard",
  "author": {
    "name": "WOMBAT",
    "email": "page@wombat-gov.dev"
  },
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "serve": "node src/server.js",
    "dashboard:build": "node scripts/build-dashboard.mjs",
    "icon": "bash scripts/make-icon.sh",
    "dmg:background": "bash scripts/make-dmg-background.sh",
    "tray:icons": "bash scripts/make-tray-icons.sh",
    "sbom": "node scripts/make-sbom.mjs",
    "assets": "npm run icon && npm run icon:win && npm run dmg:background && npm run tray:icons && npm run sbom",
    "test:smoke": "node tests/smoke.mjs",
    "package:mac": "npm run dashboard:build && npm run sbom && electron-builder --mac --x64 --arm64 --publish never",
    "test:palette": "node tests/palette-search.mjs",
    "test:device": "node tests/device-auth.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "test:ui": "node tests/ui-foundations.mjs",
    "test:a11y": "node tests/a11y.mjs",
    "test:scan": "node tests/scan-notifications.mjs",
    "test:scan-state": "node tests/scan-state.mjs",
    "test:run": "node tests/run-context.mjs",
    "test:crash": "node tests/crash-diagnostics.mjs",
    "test:update": "node tests/updates.mjs",
    "test:onboarding": "node tests/onboarding.mjs",
    "test:tabs": "node tests/tabs.mjs",
    "test:auth": "node tests/auth-lifecycle.mjs",
    "test:i18n": "node tests/i18n-pseudo.mjs",
    "test:perf": "node tests/perf.mjs",
    "test:visual": "node tests/visual.mjs",
    "test:settings": "node tests/settings-state.mjs",
    "icon:win": "node scripts/make-win-icon.mjs",
    "package:win": "npm run dashboard:build && npm run sbom && electron-builder --win --publish never",
    "package:linux": "npm run dashboard:build && npm run sbom && electron-builder --linux --publish never"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.0",
    "axe-core": "^4.14.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "pixelmatch": "^8.0.0",
    "playwright-core": "^1.65.0",
    "png-to-ico": "^3.0.2",
    "pngjs": "^7.0.0"
  },
  "license": "Apache-2.0"
}
